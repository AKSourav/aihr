# Local services
DATABASE_URL=postgresql+asyncpg://app:app@postgres:5432/hr
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default
S3_ENDPOINT=http://minio:9000
S3_BUCKET=hr-artifacts
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
API_INTERNAL_URL=http://api:8000
INTERNAL_API_TOKEN=dev-internal-token

# LiveKit Cloud
LIVEKIT_URL=wss://<project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_SIP_TRUNK_ID=                  # Phase 5
AGENT_NAME=hr-screener

# Providers
DEEPGRAM_API_KEY=
LLM_API_KEY=
LLM_CALL_MODEL=                        # fast model for live conversation
LLM_SUMMARY_MODEL=                     # stronger model for summaries
TTS_API_KEY=
TTS_VOICE_ID=

# Behaviour
CALL_MODE=web                          # web | sip  (see §3)
CALL_SIGNAL_TIMEOUT_MIN=45
MAX_CALL_DURATION_MIN=20
RECORDING_ENABLED=false                # Phase 6
