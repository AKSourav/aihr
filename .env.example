# Host ports (change only if something else already owns one)
API_PORT=8000
KEYCLOAK_PORT=8080
POSTGRES_PORT=5432
REDIS_PORT=6379
MAILPIT_PORT=8025

# Local services
DATABASE_URL=postgresql+asyncpg://app:app@postgres:5432/hr
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default
S3_ENDPOINT=http://minio:9000
S3_BUCKET=hr-artifacts
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
API_INTERNAL_URL=http://api:8000
INTERNAL_API_TOKEN=dev-internal-token
# agent worker only: unlocks decrypted tenant provider keys, so it must differ from
# INTERNAL_API_TOKEN (which OPA also holds). Empty means no one can fetch them.
AGENT_API_TOKEN=dev-agent-token

# LiveKit Cloud
LIVEKIT_URL=wss://<project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Phase 5
LIVEKIT_SIP_TRUNK_ID=
AGENT_NAME=hr-screener

# Providers
DEEPGRAM_API_KEY=
LLM_API_KEY=
# set for an OpenAI-compatible gateway, e.g. https://openrouter.ai/api/v1
LLM_BASE_URL=
# fast model for live conversation
LLM_CALL_MODEL=
# stronger model for summaries
LLM_SUMMARY_MODEL=
TTS_API_KEY=
TTS_VOICE_ID=
# urlsafe base64 32-byte Fernet key, encrypts tenant provider keys at rest;
# production sets this from a secret store. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PROVIDER_ENCRYPTION_KEY=

# Identity
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_ISSUER_URL=http://localhost:8080
KEYCLOAK_REALM=aihr
KEYCLOAK_AUDIENCE=aihr-api
KEYCLOAK_ADMIN_CLIENT_ID=aihr-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=local-admin-secret

# Email invites (candidate joins the screening from a link in their email)
PUBLIC_BASE_URL=http://localhost:8000  # where candidates reach /join/<token>
# >= 32 chars; production sets this from a secret store
INVITE_SIGNING_KEY=dev-only-not-a-secret-0000000000000000
INVITE_TTL_HOURS=72
SMTP_HOST=mailpit                      # local inbox at http://localhost:$MAILPIT_PORT
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_FROM="aihr <no-reply@aihr.local>"

# Behaviour
DEV_ROUTES_ENABLED=true                # exposes POST /tenants/{org_id}/calls; keep false outside local dev
CALL_MODE=web                          # web | sip  (see §3)
CALL_SIGNAL_TIMEOUT_MIN=45
MAX_CALL_DURATION_MIN=20
RECORDING_ENABLED=false                # Phase 6
