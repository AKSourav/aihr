{
  "realm": "aihr",
  "enabled": true,
  "accessTokenLifespan": 600,
  "ssoSessionIdleTimeout": 28800,
  "ssoSessionMaxLifespan": 36000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "bruteForceProtected": false,
  "roles": {
    "realm": [
      {
        "name": "platform_admin",
        "description": "Platform operator. Grants no tenant data access on its own; see break-glass."
      }
    ]
  },
  "clients": [
    {
      "clientId": "aihr-api",
      "name": "aihr API",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    },
    {
      "clientId": "aihr-web",
      "name": "aihr Web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": ["http://localhost:3000/*"],
      "webOrigins": ["http://localhost:3000"],
      "attributes": { "pkce.code.challenge.method": "S256" },
      "protocolMappers": [
        {
          "name": "aihr-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "aihr-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "aihr-local-cli",
      "name": "Local development CLI (password grant, local overlay only)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocolMappers": [
        {
          "name": "aihr-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "aihr-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "aihr-desktop",
      "name": "aihr Desktop",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://127.0.0.1:47823/callback"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://127.0.0.1:47823/logout"
      },
      "protocolMappers": [
        {
          "name": "aihr-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "aihr-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "id": "11111111-1111-1111-1111-111111111111",
      "username": "recruiter",
      "email": "recruiter@acme.test",
      "firstName": "Reena",
      "lastName": "Recruiter",
      "emailVerified": true,
      "enabled": true,
      "credentials": [{ "type": "password", "value": "recruiter", "temporary": false }]
    },
    {
      "id": "22222222-2222-2222-2222-222222222222",
      "username": "viewer",
      "email": "viewer@acme.test",
      "firstName": "Vijay",
      "lastName": "Viewer",
      "emailVerified": true,
      "enabled": true,
      "credentials": [{ "type": "password", "value": "viewer", "temporary": false }]
    },
    {
      "id": "33333333-3333-3333-3333-333333333333",
      "username": "root",
      "email": "root@aihr.test",
      "firstName": "Root",
      "lastName": "Operator",
      "emailVerified": true,
      "enabled": true,
      "realmRoles": ["platform_admin"],
      "credentials": [{ "type": "password", "value": "root", "temporary": false }]
    },
    {
      "id": "44444444-4444-4444-4444-444444444444",
      "username": "outsider",
      "email": "outsider@nowhere.test",
      "firstName": "Olly",
      "lastName": "Outsider",
      "emailVerified": true,
      "enabled": true,
      "credentials": [{ "type": "password", "value": "outsider", "temporary": false }]
    }
  ]
}
